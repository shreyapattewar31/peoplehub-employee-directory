# Leave this as /api when using the Vite development proxy.
VITE_API_BASE_URL=/api
# Optional canonical browser URL used when a separate frontend needs absolute links.
VITE_PUBLIC_APP_URL=http://localhost:5173
# Optional Express target for the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:4000
# Cloudflare Turnstile visible always-pass test site key for local development.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
